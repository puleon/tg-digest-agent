# ~/.config/systemd/user/tgdigest-refresh.timer — installed by `make units`, then
# `systemctl --user enable --now tgdigest-refresh.timer`.
# 13:00 box time (MSK), chosen by the owner: the new batch is ready in the afternoon, well
# clear of the evening ritual of the assistant that shares the model and its 04:00 reset.
# A usual run (≈ 90 new posts) takes minutes to about half an hour; the first run after a
# long gap takes hours.
# Persistent: a day the box was off is caught up at boot.
[Unit]
Description=Daily corpus refresh for tg-digest-agent

[Timer]
OnCalendar=*-*-* 13:00:00
Persistent=true

[Install]
WantedBy=timers.target
