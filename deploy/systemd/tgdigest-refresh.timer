# ~/.config/systemd/user/tgdigest-refresh.timer — installed by `make units`, then
# `systemctl --user enable --now tgdigest-refresh.timer`.
# 02:30 box time (MSK): after the evening ritual of the assistant that shares the model; a
# usual night (≈ 90 new posts) should be done before its 04:00 reset and the morning issues.
# Persistent: a night the box was off is caught up at boot.
[Unit]
Description=Nightly corpus refresh for tg-digest-agent

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true

[Install]
WantedBy=timers.target
